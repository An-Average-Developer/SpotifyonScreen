<Window x:Class="SpotifyOnScreen.Windows.TwitchClientIdHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connecting a Spotify Client ID for Twitch"
        Height="480"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E">

    <Window.Resources>
        <SolidColorBrush x:Key="SpotifyGreen" Color="#1DB954"/>
        <SolidColorBrush x:Key="SpotifyGreenHover" Color="#1ED760"/>
        <SolidColorBrush x:Key="SurfaceColor" Color="#2A2A3A"/>
        <SolidColorBrush x:Key="BorderColor" Color="#3E3E4E"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#A0A0B0"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource SpotifyGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource SpotifyGreenHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource SpotifyGreen}"/>
            <Setter Property="TextDecorations" Value="None"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1A1A26" Padding="24,18">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="14" Height="14" Fill="{StaticResource SpotifyGreen}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CONNECT SPOTIFY FOR TWITCH" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="A Spotify Client ID lets the app queue songs your viewers request in chat."
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="{StaticResource SpotifyGreen}" Width="24" Height="24" CornerRadius="12" Margin="0,0,12,0">
                        <TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap">
                        <Run Text="Go to "/>
                        <Hyperlink NavigateUri="https://developer.spotify.com/dashboard" RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="developer.spotify.com/dashboard"/>
                        </Hyperlink>
                        <Run Text=" and log in"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="{StaticResource SpotifyGreen}" Width="24" Height="24" CornerRadius="12" Margin="0,0,12,0">
                        <TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Create a new app (any name, any description)"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="{StaticResource SpotifyGreen}" Width="24" Height="24" CornerRadius="12" Margin="0,0,12,0">
                        <TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap">
                        <Run Text="In app settings, add redirect URI: "/>
                        <Run Text="http://127.0.0.1:4202" Foreground="{StaticResource SpotifyGreen}" FontWeight="Medium"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="{StaticResource SpotifyGreen}" Width="24" Height="24" CornerRadius="12" Margin="0,0,12,0">
                        <TextBlock Text="4" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Copy the Client ID and paste it into the box in the Twitch tab"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextPrimary}"
                             TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="{StaticResource SpotifyGreen}" Width="24" Height="24" CornerRadius="12" Margin="0,0,12,0">
                        <TextBlock Text="5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Click 'Connect to Spotify' and authorize the app"
                             VerticalAlignment="Center"
                             Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <Border Background="#3E3E2E" CornerRadius="8" Padding="16" BorderBrush="#5E5E3E" BorderThickness="1" Margin="0,8,0,0">
                    <TextBlock Text="Once connected, viewers can queue a song with your Twitch chat command, e.g. !sr Never Gonna Give You Up."
                             FontStyle="Italic"
                             Foreground="{StaticResource TextSecondary}"
                             TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="24,0,24,20">
            <Button HorizontalAlignment="Right"
                  Content="Got it"
                  Style="{StaticResource ModernButton}"
                  Click="CloseBtn_Click"/>
        </Border>
    </Grid>
</Window>
